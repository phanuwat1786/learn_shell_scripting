# address_book.lib

add_address()
{
    echo "Adding new address"
    echo -n "Enter Name : "
    read name
    echo -n "Enter Surname : "
    read surname

    fullname=`echo "${name} ${surname}"`

    if [ -f ./address_book.txt ]; then
        grep -q "$fullname:" ./address_book.txt
        grep_return_code=$?
        
        if [ $grep_return_code -eq "1" ]; then
            
            echo -n "Enter Phone number (can be blank) : "
            read phone
            echo -n "Enter email (can be blank) : "
            read email
            echo "${fullname}:${phone:-undefined}:${email:-undefined}" &>> ./address_book.txt
            
            echo "user ${fullname} added successfully."
        
        else
            echo "${fullname}'s address already exist."
            update=""
            while :
            do
                echo -n "want to update ? (y/n) : "
                read update
                if [ $update = "y" ]; then
                
                    cline=`grep "${fullname}:" ./address_book.txt`
                    nline="$cline"
                    cphone=`echo $cline | cut -d: -f2`
                    cemail=`echo $cline | cut -d: -f3`
                    echo "current email is : $cemail"
                    echo -n "enter new email (left blank to skip) : "
                    read nmail
                    if [ -n "$nmail" ]; then
                        nline=`echo "$nline" | sed s/"$cemail"/"$nmail"/g`
                    fi 
                    echo "current phone number is $cphone"
                    echo -n "enter new phone (left blank to skip) : "
                    read nphone
                    if [ -n "$nphone" ]; then
                        nline=`echo "$nline" | sed s/"$cphone"/"$nphone"/g`
                    fi

                    echo "address will be update with"
                    echo "phone : ${nphone:-$cphone}"
                    echo "email : ${nmail:-$cemail}"
                    echo "enter y to confirm, other will cancel and back to main menu"
                    read confirm

                    if [ "$confirm" = y ]; then
                        sed -i "s/$cline/$nline/" ./address_book.txt
                        echo "successfully update ${fullname}'s address"
                    fi

                    break

                elif [ $update = "n" ]; then
                    echo "${fullname}'s address not change."
                    break
                else
                    echo "only y or n"
                fi
            done
        fi

    else
        echo -n "Enter Phone number (can be blank) : "
        read phone
        echo -n "Enter email (can be blank) : "
        read email
        echo "${fullname}:${phone:-undefined}:${email:-undefined}" &>> ./address_book.txt
        
        echo "user ${fullname} added successfully."
    fi
}